    ; Mirror the actual saved pickup total instead of a patch-era lifetime counter.
L_202_package_event:
    Push 321
    Push 101
    GetStaticPs
    pGet
    CallNative SET_INT_STAT 2 0
L_202_package_event_done:
    CallNative ADD_SCORE 2 0
    Jump @L_000efe

L_202_sync_packages:
    Function 0 2
    ; TIMERB is otherwise unused by this script. Backfill loaded saves every 2 s.
    CallNative TIMERB 0 1
    Push 2000
    CmpLT
    JumpFalse @L_202_package_refresh
    Return 0 0
L_202_package_refresh:
    Push 0
    CallNative SETTIMERB 1 0
    Push 321
    CallNative GET_INT_STAT 1 1
    Push 101
    GetStaticPs
    pGet
    CmpEQ
    JumpFalse @L_202_package_set
    Return 0 0
